---
const today = new Date();
---

<footer>
	<div class="ftr-inner">
		<span>© {today.getFullYear()} t-log</span>
		<span class="ftr-sep">·</span>
		<span>Built with Astro</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--hairline);
		padding: 32px 24px;
		text-align: center;
		font-size: 12px;
		color: var(--muted);
		background: var(--bg);
	}
	.ftr-inner {
		display: inline-flex;
		gap: 12px;
		align-items: center;
	}
	.ftr-sep {
		opacity: 0.5;
	}
</style>
