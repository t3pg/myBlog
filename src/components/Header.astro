---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<a href="#main-content" class="skip-link">コンテンツへスキップ</a>
<header>
	<div class="hdr-inner">
		<a href="/" class="brand">
			<span>{SITE_TITLE}</span>
			<span class="brand-dot" aria-hidden="true"></span>
		</a>
		<nav class="hdr-nav">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>

			<button
				type="button"
				id="color-mode-toggle"
				class="hdr-icon hdr-toggle"
				aria-label="カラーモードを切り替え"
				title="Toggle color mode"
			>
				<span class="moon">
					<svg viewBox="0 0 24 24" width="1.1rem" height="1.1rem" fill="currentColor" aria-hidden="true">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
					</svg>
				</span>
				<span class="sun">
					<svg viewBox="0 0 24 24" width="1.1rem" height="1.1rem" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="4" />
						<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
					</svg>
				</span>
			</button>

			<a
				href="https://github.com/t3pg"
				target="_blank"
				rel="noopener"
				class="hdr-icon"
				aria-label="GitHub"
			>
				<svg viewBox="0 0 24 24" width="1.2rem" height="1.2rem" fill="currentColor" aria-hidden="true">
				<path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z" />
			</svg>
			</a>
		</nav>
	</div>
</header>

<script is:inline>
	// Toggle button — apply selected theme, persist in localStorage.
	// 初期 theme は BaseHead.astro 内のインラインスクリプトで設定済み。
	(function () {
		const btn = document.getElementById("color-mode-toggle");
		if (!btn) return;
		btn.addEventListener("click", () => {
			const current =
				document.documentElement.getAttribute("data-theme") ||
				(window.matchMedia("(prefers-color-scheme: dark)").matches
					? "dark"
					: "light");
			const next = current === "dark" ? "light" : "dark";
			document.documentElement.setAttribute("data-theme", next);
			try {
				localStorage.setItem("theme", next);
			} catch (e) {}
		});
	})();
</script>

<style>
	.skip-link {
		position: absolute;
		top: -100%;
		left: 16px;
		padding: 8px 16px;
		background: var(--accent);
		color: #fff;
		font-size: 13px;
		font-weight: 600;
		border-radius: 0 0 6px 6px;
		text-decoration: none;
		z-index: 100;
		transition: top 0.1s;
	}
	.skip-link:focus {
		top: 0;
	}

	header {
		border-bottom: 1px solid var(--hairline);
		background: var(--bg);
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: saturate(140%) blur(8px);
	}

	.hdr-inner {
		max-width: 1080px;
		margin: 0 auto;
		padding: 14px 24px;
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.brand {
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--ink);
		text-decoration: none;
		display: inline-flex;
		align-items: baseline;
		gap: 6px;
	}
	.brand-dot {
		width: 6px;
		height: 6px;
		background: var(--accent);
		border-radius: 50%;
		display: inline-block;
		transform: translateY(-2px);
	}

	.hdr-nav {
		display: flex;
		gap: 2px;
		margin-left: auto;
		align-items: center;
	}

	.hdr-nav :global(a):not(.hdr-icon) {
		font-size: 13.5px;
		color: var(--muted);
		padding: 6px 10px;
		border-radius: 6px;
		transition:
			color 0.15s,
			background 0.15s;
		text-decoration: none;
	}
	.hdr-nav :global(a):not(.hdr-icon):hover {
		color: var(--ink);
		background: var(--hairline);
	}
	.hdr-nav :global(a.active) {
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
	}

	.hdr-icon {
		display: inline-flex;
		width: 32px;
		height: 32px;
		align-items: center;
		justify-content: center;
		color: var(--muted);
		background: transparent;
		border: 0;
		padding: 0;
		cursor: pointer;
		border-radius: 6px;
		margin-left: 4px;
		transition:
			color 0.15s,
			background 0.15s;
		text-decoration: none;
	}
	.hdr-icon:hover {
		color: var(--ink);
		background: var(--hairline);
	}

	.hdr-toggle {
		position: relative;
	}
	.hdr-toggle .sun,
	.hdr-toggle .moon {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		transition:
			opacity 0.2s,
			transform 0.2s;
	}
	:global([data-theme="light"]) .hdr-toggle .sun,
	:global(:root:not([data-theme="dark"])) .hdr-toggle .sun {
		opacity: 0;
		transform: rotate(-30deg) scale(0.7);
	}
	:global([data-theme="light"]) .hdr-toggle .moon,
	:global(:root:not([data-theme="dark"])) .hdr-toggle .moon {
		opacity: 1;
		transform: rotate(0) scale(1);
	}
	:global([data-theme="dark"]) .hdr-toggle .sun {
		opacity: 1;
		transform: rotate(0) scale(1);
	}
	:global([data-theme="dark"]) .hdr-toggle .moon {
		opacity: 0;
		transform: rotate(30deg) scale(0.7);
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme="light"])) .hdr-toggle .sun {
			opacity: 1;
			transform: rotate(0) scale(1);
		}
		:global(:root:not([data-theme="light"])) .hdr-toggle .moon {
			opacity: 0;
			transform: rotate(30deg) scale(0.7);
		}
	}

	@media (max-width: 720px) {
		.hdr-inner {
			padding: 12px 18px;
			gap: 12px;
		}
		.hdr-nav {
			gap: 0;
		}
		.hdr-nav :global(a):not(.hdr-icon) {
			padding: 6px 8px;
			font-size: 12.5px;
		}
		/* ブランドロゴがホームへのリンクを兼ねるため、モバイルでは "Home" を非表示 */
		.hdr-nav :global(a[href="/"]):not(.hdr-icon) {
			display: none;
		}
	}
</style>
