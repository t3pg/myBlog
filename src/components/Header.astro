---
import { Icon } from "@astrojs/starlight/components";
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header>
	<div class="hdr-inner">
		<a href="/" class="brand">
			<span>{SITE_TITLE}</span>
			<span class="brand-dot" aria-hidden="true"></span>
		</a>
		<nav class="hdr-nav">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>

			<button
				type="button"
				id="color-mode-toggle"
				class="hdr-icon hdr-toggle"
				aria-label="カラーモードを切り替え"
				title="Toggle color mode"
			>
				<span class="moon"><Icon name="moon" size="1.1rem" /></span>
				<span class="sun"><Icon name="sun" size="1.1rem" /></span>
			</button>

			<a
				href="https://github.com/t3pg"
				target="_blank"
				rel="noopener"
				class="hdr-icon"
				aria-label="GitHub"
			>
				<Icon name="github" size="1.2rem" />
			</a>
		</nav>
	</div>
</header>

<script is:inline>
	// Toggle button — apply selected theme, persist in localStorage.
	// 初期 theme は BaseHead.astro 内のインラインスクリプトで設定済み。
	(function () {
		const btn = document.getElementById("color-mode-toggle");
		if (!btn) return;
		btn.addEventListener("click", () => {
			const current =
				document.documentElement.getAttribute("data-theme") ||
				(window.matchMedia("(prefers-color-scheme: dark)").matches
					? "dark"
					: "light");
			const next = current === "dark" ? "light" : "dark";
			document.documentElement.setAttribute("data-theme", next);
			try {
				localStorage.setItem("theme", next);
			} catch (e) {}
		});
	})();
</script>

<style>
	header {
		border-bottom: 1px solid var(--hairline);
		background: var(--bg);
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: saturate(140%) blur(8px);
	}

	.hdr-inner {
		max-width: 1080px;
		margin: 0 auto;
		padding: 14px 24px;
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.brand {
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--ink);
		text-decoration: none;
		display: inline-flex;
		align-items: baseline;
		gap: 6px;
	}
	.brand-dot {
		width: 6px;
		height: 6px;
		background: var(--accent);
		border-radius: 50%;
		display: inline-block;
		transform: translateY(-2px);
	}

	.hdr-nav {
		display: flex;
		gap: 2px;
		margin-left: auto;
		align-items: center;
	}

	.hdr-nav :global(a):not(.hdr-icon) {
		font-size: 13.5px;
		color: var(--muted);
		padding: 6px 10px;
		border-radius: 6px;
		transition: color .15s, background .15s;
		text-decoration: none;
	}
	.hdr-nav :global(a):not(.hdr-icon):hover {
		color: var(--ink);
		background: var(--hairline);
	}
	.hdr-nav :global(a.active) {
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
	}

	.hdr-icon {
		display: inline-flex;
		width: 32px;
		height: 32px;
		align-items: center;
		justify-content: center;
		color: var(--muted);
		background: transparent;
		border: 0;
		padding: 0;
		cursor: pointer;
		border-radius: 6px;
		margin-left: 4px;
		transition: color .15s, background .15s;
		text-decoration: none;
	}
	.hdr-icon:hover {
		color: var(--ink);
		background: var(--hairline);
	}

	.hdr-toggle {
		position: relative;
	}
	.hdr-toggle .sun,
	.hdr-toggle .moon {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: opacity .2s, transform .2s;
	}
	:global([data-theme="light"]) .hdr-toggle .sun,
	:global(:root:not([data-theme="dark"])) .hdr-toggle .sun {
		opacity: 0;
		transform: rotate(-30deg) scale(0.7);
	}
	:global([data-theme="light"]) .hdr-toggle .moon,
	:global(:root:not([data-theme="dark"])) .hdr-toggle .moon {
		opacity: 1;
		transform: rotate(0) scale(1);
	}
	:global([data-theme="dark"]) .hdr-toggle .sun {
		opacity: 1;
		transform: rotate(0) scale(1);
	}
	:global([data-theme="dark"]) .hdr-toggle .moon {
		opacity: 0;
		transform: rotate(30deg) scale(0.7);
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme="light"])) .hdr-toggle .sun {
			opacity: 1;
			transform: rotate(0) scale(1);
		}
		:global(:root:not([data-theme="light"])) .hdr-toggle .moon {
			opacity: 0;
			transform: rotate(30deg) scale(0.7);
		}
	}

	@media (max-width: 720px) {
		.hdr-inner {
			padding: 12px 18px;
			gap: 12px;
		}
		.hdr-nav {
			gap: 0;
		}
		.hdr-nav :global(a):not(.hdr-icon) {
			padding: 6px 8px;
			font-size: 12.5px;
		}
	}
</style>
