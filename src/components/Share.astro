---
import { Icon } from "@astrojs/starlight/components";
const link = Astro.props.link;
---

<div class="share">
	<a
		href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(link)}`}
		target="_blank"
		rel="noopener"
		aria-label="Share on X"
	>
		<Icon name="x.com" size="0.95rem" />
	</a>
	<a
		href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(link)}`}
		target="_blank"
		rel="noopener"
		aria-label="Share on Facebook"
	>
		<Icon name="facebook" size="0.95rem" />
	</a>
	<span class="copy-wrap">
		<button
			type="button"
			id="copy-link"
			aria-label="リンクをコピー"
			data-link={link.toString()}
		>
			<Icon name="link" size="0.95rem" />
		</button>
		<span id="copy-toast" class="copy-toast">コピーしました</span>
	</span>
</div>

<script is:inline>
	(function () {
		const btn = document.getElementById("copy-link");
		if (!btn) return;
		btn.addEventListener("click", () => {
			const link = btn.dataset.link;
			if (!link) return;
			navigator.clipboard.writeText(link).then(() => {
				const t = document.getElementById("copy-toast");
				if (!t) return;
				t.classList.add("show");
				setTimeout(() => t.classList.remove("show"), 1500);
			});
		});
	})();
</script>

<style>
	.share {
		display: flex;
		gap: 8px;
		margin: 40px 0 24px;
	}
	.share > a,
	.share > .copy-wrap > button {
		width: 34px;
		height: 34px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--hairline-strong);
		background: transparent;
		border-radius: 50%;
		color: var(--muted);
		font-size: 13px;
		text-decoration: none;
		cursor: pointer;
		padding: 0;
		transition: color .15s, border-color .15s;
	}
	.share > a:hover,
	.share > .copy-wrap > button:hover {
		color: var(--accent-text);
		border-color: var(--accent);
	}
	.copy-wrap {
		position: relative;
		display: inline-block;
	}
	.copy-toast {
		position: absolute;
		bottom: calc(100% + 6px);
		left: 50%;
		transform: translateX(-50%);
		background: var(--ink);
		color: var(--bg);
		font-size: 0.75rem;
		white-space: nowrap;
		padding: 4px 8px;
		border-radius: 4px;
		pointer-events: none;
		opacity: 0;
		transition: opacity .2s;
	}
	.copy-toast::after {
		content: "";
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		border: 5px solid transparent;
		border-top-color: var(--ink);
	}
	.copy-toast.show {
		opacity: 1;
	}
</style>
