---
import { getCollection } from "astro:content";
import { SIDEBAR_TAGS } from "../consts";

const allPosts = await getCollection("blog");
const sorted = [...allPosts].sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 最近の記事 (5件)
const recentPosts = sorted.slice(0, 5);

// 月別アーカイブ
const monthMap = new Map<string, number>();
allPosts.forEach((post) => {
	const d = post.data.pubDate;
	const year = d.getFullYear().toString();
	const month = String(d.getMonth() + 1).padStart(2, "0");
	const key = `${year}/${month}`;
	monthMap.set(key, (monthMap.get(key) ?? 0) + 1);
});
const sortedMonths = [...monthMap.entries()].sort((a, b) =>
	b[0].localeCompare(a[0]),
);
---

<aside class="sidebar">
	<!-- プロフィール -->
	<section class="sidebar-section">
		<h2 class="sidebar-heading">Profile</h2>
		<div class="profile">
			<div class="profile-avatar" aria-hidden="true">t</div>
			<div>
				<div class="profile-handle">t3pg</div>
				<div class="profile-bio">日々のメモ。</div>
			</div>
		</div>
	</section>

	<!-- 最近の記事 -->
	<section class="sidebar-section">
		<h2 class="sidebar-heading">Recent</h2>
		<ul class="sidebar-list">
			{
				recentPosts.map((post) => (
					<li>
						<a href={`/blog/${post.id.split("/").pop()}/`}>
							{post.data.title}
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<!-- タグ -->
	<section class="sidebar-section">
		<h2 class="sidebar-heading">Tags</h2>
		<div class="tag-cloud">
			{
				SIDEBAR_TAGS.map((tag) => (
					<a href={`/tags/${tag}/`} class="tag-pill">
						{tag}
					</a>
				))
			}
		</div>
		<a href="/tags/" class="all-tags-link">すべてのタグ →</a>
	</section>

	<!-- 月別アーカイブ -->
	<section class="sidebar-section">
		<h2 class="sidebar-heading">Archive</h2>
		<ul class="sidebar-list">
			{
				sortedMonths.map(([key, count]) => {
					const [year, month] = key.split("/");
					return (
						<li>
							<a
								href={`/blog/${year}/${month}/`}
								class="archive-link"
							>
								<span>
									{year}.{month}
								</span>
								<span class="archive-count">{count}</span>
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>
</aside>

<style>
	.sidebar {
		display: flex;
		flex-direction: column;
		gap: 36px;
		min-width: 0;
		font-size: 13px;
	}

	.sidebar-section {
		padding: 0;
		border: 0;
		background: transparent;
	}

	.sidebar-heading {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0 0 14px;
		padding-bottom: 8px;
		border-bottom: 1px solid var(--hairline);
	}

	.profile {
		display: flex;
		gap: 12px;
		align-items: center;
	}
	.profile-avatar {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--hairline);
		color: var(--muted);
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 14px;
		font-weight: 700;
	}
	.profile-handle {
		font-weight: 600;
		font-size: 13.5px;
		color: var(--ink);
	}
	.profile-bio {
		font-size: 12px;
		color: var(--muted);
		line-height: 1.55;
		margin-top: 2px;
	}

	.sidebar-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.sidebar-list li a {
		display: block;
		color: var(--ink-2);
		font-size: 13px;
		line-height: 1.5;
		padding: 0;
		text-decoration: none;
		transition: color .15s;
	}

	.sidebar-list li a:hover {
		color: var(--accent-text);
	}

	.archive-link {
		display: flex !important;
		justify-content: space-between;
		align-items: baseline;
		font-variant-numeric: tabular-nums;
	}
	.archive-count {
		color: var(--muted);
		font-size: 12px;
	}

	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 12px;
	}

	.tag-pill {
		font-size: 12.5px;
		color: var(--ink-2);
		text-decoration: none;
		padding: 0;
		background: transparent;
		transition: color .15s;
	}
	.tag-pill::before {
		content: "#";
		opacity: 0.55;
		margin-right: 1px;
	}
	.tag-pill:hover {
		color: var(--accent-text);
		background: transparent;
	}

	.all-tags-link {
		display: inline-block;
		margin-top: 14px;
		font-size: 12px;
		color: var(--muted);
		text-decoration: none;
		transition: color .15s;
	}

	.all-tags-link:hover {
		color: var(--accent-text);
	}

	@media (max-width: 880px) {
		.sidebar {
			gap: 28px;
		}
	}
</style>
