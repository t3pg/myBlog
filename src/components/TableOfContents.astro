---
import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
	minDepth?: number;
	maxDepth?: number;
}

const { headings, minDepth = 1, maxDepth = 3 } = Astro.props;
const items = headings.filter((h) => h.depth >= minDepth && h.depth <= maxDepth);
---

{
	items.length > 0 && (
		<ul class="toc-list">
			{items.map((h) => (
				<li class={`toc-item toc-h${h.depth}`}>
					<a href={`#${h.slug}`}>{h.text}</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.toc-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.toc-item a {
		display: block;
		color: var(--ink-2);
		font-size: 13px;
		text-decoration: none;
		line-height: 1.5;
		transition: color 0.15s;
	}
	.toc-item a:hover {
		color: var(--accent-text);
	}
	.toc-h1,
	.toc-h2 {
		padding-left: 0;
	}
	.toc-h3 {
		padding-left: 1em;
	}
	.toc-h3 a {
		font-size: 12.5px;
		color: var(--muted);
	}
	.toc-h3 a:hover {
		color: var(--accent-text);
	}
</style>
