---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseHead from "../components/BaseHead.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Share from "../components/Share.astro";
import { GISCUS_CONFIG } from "../consts";

type Props = CollectionEntry<"blog">["data"] & {
	prev?: CollectionEntry<"blog">;
	next?: CollectionEntry<"blog">;
	headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, tags, prev, next, headings } =
	Astro.props;

const tocItems = (headings ?? []).filter((h) => h.depth >= 1 && h.depth <= 3);
const hasToc = tocItems.length > 0;
---

<html lang="ja">
	<head>
		<BaseHead
			title={title}
			description={description}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate}
		/>
	</head>

	<body>
		<Header />
		<div class={`layout-wrapper${hasToc ? " has-toc" : ""}`}>
			{
				hasToc && (
					<aside class="toc-sidebar" aria-label="目次">
						<p class="toc-sidebar-heading">目次</p>
						<TableOfContents headings={headings} />
					</aside>
				)
			}
			<main id="main-content">
				<article>
					<div class="prose">
						<header class="article-head">
							<div class="article-meta">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<>
											<span class="dot">·</span>
											<span class="updated">
												Updated{" "}
												<FormattedDate
													date={updatedDate}
												/>
											</span>
										</>
									)
								}
							</div>
							<h1 class="article-title">{title}</h1>
							{
								tags && tags.length > 0 && (
									<div class="article-tags">
										{tags.map((tag) => (
											<a
												href={`/tags/${tag}/`}
												class="article-tag"
											>
												{tag}
											</a>
										))}
									</div>
								)
							}
						</header>

						{
							hasToc && (
								<details class="toc-mobile">
									<summary class="toc-mobile-summary">目次</summary>
									<div class="toc-mobile-body">
										<TableOfContents headings={headings} />
									</div>
								</details>
							)
						}

						<slot />

						<script is:inline>
							/* YouTube 埋め込み: クリックでサムネイルを iframe に差し替え */
							document.addEventListener('click', function (e) {
								var btn = e.target.closest('.yt-play');
								if (!btn) return;
								var embed = btn.closest('.yt-embed');
								var src = btn.dataset.src;
								if (!embed || !src) return;
								embed.innerHTML =
									'<iframe src="' + src + '" ' +
									'allow="autoplay;encrypted-media;picture-in-picture" ' +
									'allowfullscreen loading="lazy" title="YouTube動画"></iframe>';
							});
						</script>

						<script is:inline>
							/* リンクカード: OGP画像読み込み失敗時にサムネイル欄を非表示 */
							document
								.querySelectorAll(
									".remark-link-card-plus__image",
								)
								.forEach(function (img) {
									img.addEventListener("error", function () {
										var thumbnail = img.closest(
											".remark-link-card-plus__thumbnail",
										);
										if (thumbnail)
											thumbnail.style.display = "none";
									});
								});
						</script>

						<script is:inline>
							/* テーマ判定の共通ヘルパー（絵文字・Giscus で共有） */
							window.__isDarkTheme = function () {
								var t = document.documentElement.getAttribute("data-theme");
								return t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches);
							};
						</script>

						<script is:inline>
							/* 絵文字: カラーモード切替に応じて src を差し替え */
							(function () {
								function applyEmojiTheme() {
									var dark = window.__isDarkTheme();
									document.querySelectorAll("img.emoji-themed").forEach(function (img) {
										var src = dark ? img.dataset.emojiDark : img.dataset.emojiLight;
										if (src) {
											img.style.visibility = "";
											if (img.getAttribute("src") !== src) img.src = src;
										} else {
											img.style.visibility = "hidden";
										}
									});
								}
								applyEmojiTheme();
								new MutationObserver(applyEmojiTheme).observe(
									document.documentElement,
									{ attributes: true, attributeFilter: ["data-theme"] }
								);
								window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function () {
									if (!document.documentElement.hasAttribute("data-theme")) applyEmojiTheme();
								});
							})();
						</script>

						<Share link={Astro.url} />

						<nav class="post-nav">
							{
								prev && (
									<a
										href={`/blog/${prev.id.split("/").pop()}/`}
										class="post-nav-link no-style"
									>
										<span class="lbl">← Previous</span>
										<span class="ttl">
											{prev.data.title}
										</span>
									</a>
								)
							}
							{
								next && (
									<a
										href={`/blog/${next.id.split("/").pop()}/`}
										class="post-nav-link post-nav-next no-style"
									>
										<span class="lbl">Next →</span>
										<span class="ttl">
											{next.data.title}
										</span>
									</a>
								)
							}
						</nav>

						<div class="giscus-wrapper">
							<script is:inline define:vars={{ giscus: GISCUS_CONFIG }}>
								(function () {
									function getGiscusTheme() {
										return window.__isDarkTheme() ? "dark" : "github-light";
									}

									function sendGiscusTheme(t) {
										var iframe = document.querySelector("iframe.giscus-frame");
										if (!iframe) return;
										iframe.contentWindow.postMessage(
											{ giscus: { setConfig: { theme: t } } },
											"https://giscus.app"
										);
									}

									var script = document.createElement("script");
									script.src = "https://giscus.app/client.js";
									script.setAttribute("data-repo", giscus.repo);
									script.setAttribute("data-repo-id", giscus.repoId);
									script.setAttribute("data-category", giscus.category);
									script.setAttribute("data-category-id", giscus.categoryId);
									script.setAttribute("data-mapping", giscus.mapping);
									script.setAttribute("data-strict", "0");
									script.setAttribute("data-reactions-enabled", "1");
									script.setAttribute("data-emit-metadata", "0");
									script.setAttribute("data-input-position", "bottom");
									script.setAttribute("data-theme", getGiscusTheme());
									script.setAttribute("data-lang", giscus.lang);
									script.setAttribute("data-loading", "lazy");
									script.setAttribute("crossorigin", "anonymous");
									script.async = true;
									document.currentScript.parentNode.appendChild(script);

									// ダークモードトグル時に Giscus テーマを同期
									var observer = new MutationObserver(function () {
										sendGiscusTheme(getGiscusTheme());
									});
									observer.observe(document.documentElement, {
										attributes: true,
										attributeFilter: ["data-theme"],
									});

									// prefers-color-scheme 変化にも対応（data-theme 未設定時）
									window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function () {
										if (!document.documentElement.hasAttribute("data-theme")) {
											sendGiscusTheme(getGiscusTheme());
										}
									});
								})();
							</script>
						</div>
					</div>
				</article>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>

<style>
	/* ===== 左サイドバー TOC ===== */

	/*
	 * layout-wrapper のグリッド・max-width は変えない。
	 * TOC を <main> と同じ grid-column: 1 / row: 1 に重ねて配置し、
	 * margin-left のマイナス値でビューポート左余白に引き込む。
	 * これにより記事・右サイドバーの位置は目次なし記事と完全に一致する。
	 */
	#main-content {
		grid-column: 1;
		grid-row: 1;
	}

	.toc-sidebar {
		/* 目次なし記事と同じ grid 列・行に重ねて配置 */
		grid-column: 1;
		grid-row: 1;
		justify-self: start;
		align-self: start;
		width: 180px;
		/* 180px(幅) + 16px(余白) だけ左へ引き込む */
		margin-left: -196px;
		position: sticky;
		top: 240px;
		max-height: calc(100vh - 260px);
		overflow-y: auto;
		font-size: 13px;
		z-index: 1;
		/* デフォルト非表示。ビューポートが十分広い場合のみ表示 */
		display: none;
	}

	/* layout-wrapper の左余白に TOC が収まる幅: (vw - 1080px) / 2 ≥ 196px → vw ≥ 1472px */
	@media (min-width: 1472px) {
		.toc-sidebar {
			display: block;
		}
	}

	.toc-sidebar-heading {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0 0 14px;
		padding: 0 0 8px;
		border-bottom: 1px solid var(--hairline);
	}

	/* ===== 折りたたみ TOC (1472px 未満) ===== */
	.toc-mobile {
		display: none;
	}

	@media (max-width: 1471px) {
		.toc-mobile {
			display: block;
			margin: 0 0 2em;
			padding: 12px 16px;
			background: var(--surface);
			border: 1px solid var(--hairline);
			border-radius: 8px;
		}
		.toc-mobile-summary {
			font-size: 11px;
			font-weight: 700;
			letter-spacing: 0.15em;
			text-transform: uppercase;
			color: var(--muted);
			cursor: pointer;
			user-select: none;
			list-style: none;
			display: flex;
			align-items: center;
			gap: 6px;
			padding: 2px 0;
		}
		.toc-mobile-summary::-webkit-details-marker {
			display: none;
		}
		.toc-mobile-summary::before {
			content: "▸";
			font-size: 10px;
			transition: transform 0.15s;
			display: inline-block;
		}
		.toc-mobile[open] .toc-mobile-summary::before {
			transform: rotate(90deg);
		}
		.toc-mobile-body {
			margin-top: 12px;
			padding-top: 10px;
			border-top: 1px solid var(--hairline);
		}
	}

	/* ===== 記事ヘッダー ===== */
	.article-head {
		margin: 0 0 36px;
		padding-bottom: 24px;
		border-bottom: 1px solid var(--hairline);
	}
	.article-meta {
		display: flex;
		gap: 14px;
		align-items: center;
		font-size: 12.5px;
		color: var(--muted);
		margin-bottom: 14px;
		font-variant-numeric: tabular-nums;
	}
	.article-meta .dot {
		opacity: 0.5;
	}
	.article-meta .updated {
		font-style: italic;
	}
	.article-title {
		font-size: 28px;
		font-weight: 700;
		letter-spacing: 0.005em;
		line-height: 1.45;
		margin: 0 0 16px;
		color: var(--accent-text);
	}
	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}
	.article-tag {
		font-size: 11.5px;
		color: var(--muted);
		text-decoration: none;
		letter-spacing: 0.02em;
		transition: color .15s;
	}
	.article-tag::before {
		content: "#";
		margin-right: 1px;
		opacity: 0.55;
	}
	.article-tag:hover {
		color: var(--accent-text);
	}

	.post-nav {
		margin-top: 48px;
		padding-top: 24px;
		border-top: 1px solid var(--hairline);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}
	.post-nav-link {
		display: block;
		padding: 14px 18px;
		border: 1px solid var(--hairline);
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: border-color .15s, background .15s;
	}
	.post-nav-link:hover {
		border-color: var(--accent);
		background: var(--accent-soft);
	}
	.post-nav-link .lbl {
		display: block;
		font-size: 11px;
		color: var(--muted);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: 6px;
	}
	.post-nav-link .ttl {
		font-size: 14px;
		color: var(--ink);
		line-height: 1.5;
		font-weight: 600;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color .15s;
	}
	.post-nav-link:hover .ttl {
		color: var(--accent-text);
	}
	.post-nav-next {
		text-align: right;
		grid-column: 2;
	}

	.giscus-wrapper {
		margin-top: 40px;
		padding-top: 24px;
		border-top: 1px solid var(--hairline);
	}

	@media (max-width: 720px) {
		.article-title {
			font-size: 22px;
		}
		.post-nav {
			grid-template-columns: 1fr;
			gap: 12px;
		}
		.post-nav-next {
			text-align: left;
		}
	}
</style>
