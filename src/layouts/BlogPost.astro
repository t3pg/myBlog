---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Share from "../components/Share.astro";

type Props = CollectionEntry<"blog">["data"] & {
	prev?: CollectionEntry<"blog">;
	next?: CollectionEntry<"blog">;
};

const { title, description, pubDate, updatedDate, tags, prev, next } =
	Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<div class="layout-wrapper">
			<main>
				<article>
					<div class="prose">
						<header class="article-head">
							<div class="article-meta">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<>
											<span class="dot">·</span>
											<span class="updated">
												Updated{" "}
												<FormattedDate
													date={updatedDate}
												/>
											</span>
										</>
									)
								}
							</div>
							<h1 class="article-title">{title}</h1>
							{
								tags && tags.length > 0 && (
									<div class="article-tags">
										{tags.map((tag) => (
											<a
												href={`/tags/${tag}/`}
												class="article-tag"
											>
												{tag}
											</a>
										))}
									</div>
								)
							}
						</header>

						<slot />

						<script is:inline>
							/* リンクカード: OGP画像読み込み失敗時にサムネイル欄を非表示 */
							document
								.querySelectorAll(
									".remark-link-card-plus__image",
								)
								.forEach(function (img) {
									img.addEventListener("error", function () {
										var thumbnail = img.closest(
											".remark-link-card-plus__thumbnail",
										);
										if (thumbnail)
											thumbnail.style.display = "none";
									});
								});
						</script>

						<Share link={Astro.url} />

						<nav class="post-nav">
							{
								prev && (
									<a
										href={`/blog/${prev.id.split("/").pop()}/`}
										class="post-nav-link no-style"
									>
										<span class="lbl">← Previous</span>
										<span class="ttl">
											{prev.data.title}
										</span>
									</a>
								)
							}
							{
								next && (
									<a
										href={`/blog/${next.id.split("/").pop()}/`}
										class="post-nav-link post-nav-next no-style"
									>
										<span class="lbl">Next →</span>
										<span class="ttl">
											{next.data.title}
										</span>
									</a>
								)
							}
						</nav>

						<div class="giscus-wrapper">
							<script
								is:inline
								src="https://giscus.app/client.js"
								data-repo="t3pg/myBlog"
								data-repo-id="R_kgDORN6zFw"
								data-category="Announcements"
								data-category-id="DIC_kwDORN6zF84C7SvK"
								data-mapping="pathname"
								data-strict="0"
								data-reactions-enabled="1"
								data-emit-metadata="0"
								data-input-position="bottom"
								data-theme="light"
								data-lang="ja"
								data-loading="lazy"
								crossorigin="anonymous"
								async></script>
						</div>
					</div>
				</article>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>

<style>
	.article-head {
		margin: 0 0 36px;
		padding-bottom: 24px;
		border-bottom: 1px solid var(--hairline);
	}
	.article-meta {
		display: flex;
		gap: 14px;
		align-items: center;
		font-size: 12.5px;
		color: var(--muted);
		margin-bottom: 14px;
		font-variant-numeric: tabular-nums;
	}
	.article-meta .dot {
		opacity: 0.5;
	}
	.article-meta .updated {
		font-style: italic;
	}
	.article-title {
		font-size: 28px;
		font-weight: 700;
		letter-spacing: 0.005em;
		line-height: 1.45;
		margin: 0 0 16px;
		color: var(--accent-text);
	}
	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}
	.article-tag {
		font-size: 11.5px;
		color: var(--muted);
		text-decoration: none;
		letter-spacing: 0.02em;
		transition: color .15s;
	}
	.article-tag::before {
		content: "#";
		margin-right: 1px;
		opacity: 0.55;
	}
	.article-tag:hover {
		color: var(--accent-text);
	}

	.post-nav {
		margin-top: 48px;
		padding-top: 24px;
		border-top: 1px solid var(--hairline);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}
	.post-nav-link {
		display: block;
		padding: 14px 18px;
		border: 1px solid var(--hairline);
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: border-color .15s, background .15s;
	}
	.post-nav-link:hover {
		border-color: var(--accent);
		background: var(--accent-soft);
	}
	.post-nav-link .lbl {
		display: block;
		font-size: 11px;
		color: var(--muted);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: 6px;
	}
	.post-nav-link .ttl {
		font-size: 14px;
		color: var(--ink);
		line-height: 1.5;
		font-weight: 600;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color .15s;
	}
	.post-nav-link:hover .ttl {
		color: var(--accent-text);
	}
	.post-nav-next {
		text-align: right;
		margin-left: auto;
	}

	.giscus-wrapper {
		margin-top: 40px;
		padding-top: 24px;
		border-top: 1px solid var(--hairline);
	}

	@media (max-width: 720px) {
		.article-title {
			font-size: 22px;
		}
		.post-nav {
			grid-template-columns: 1fr;
			gap: 12px;
		}
		.post-nav-next {
			text-align: left;
		}
	}
</style>
