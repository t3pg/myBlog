---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import PostList from "../components/PostList.astro";
import Pagination from "../components/Pagination.astro";

interface Props {
	// <head> 用
	metaTitle: string;
	metaDescription: string;
	// ページ見出し（例: "All posts" / "#開発"）
	heading: string;
	// 全件数（ページ分割前の総数）
	totalCount: number;
	// 一覧でタグを表示するか
	showTags?: boolean;
	// このページに表示する記事
	posts: CollectionEntry<"blog">[];
	// ページネーション
	currentPage: number;
	lastPage: number;
	hrefForPage: (page: number) => string;
}

const {
	metaTitle,
	metaDescription,
	heading,
	totalCount,
	showTags = false,
	posts,
	currentPage,
	lastPage,
	hrefForPage,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={metaTitle} description={metaDescription} />
	</head>
	<body>
		<Header />
		<div class="layout-wrapper">
			<main id="main-content">
				<header class="pg-intro">
					<h1 class="pg-title">{heading}</h1>
					<span class="pg-meta">{totalCount} entries</span>
				</header>

				<slot name="subhead" />

				<PostList posts={posts} showTags={showTags} />

				<Pagination
					currentPage={currentPage}
					lastPage={lastPage}
					hrefForPage={hrefForPage}
				/>

				<slot name="footer-extra" />
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>

<style>
	.pg-intro {
		margin-bottom: 28px;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		border-bottom: 1px solid var(--hairline);
		padding-bottom: 16px;
	}
	.pg-title {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 0.01em;
		margin: 0;
	}
	.pg-meta {
		font-size: 12.5px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 720px) {
		.pg-title {
			font-size: 19px;
		}
	}
</style>
