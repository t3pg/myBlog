---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="ja">
    <head>
        <BaseHead
            title={`404 - ${SITE_TITLE}`}
            description="ページが見つかりませんでした"
            noindex={true}
        />
        <style>
            .not-found {
                padding: 4em 1em;
                text-align: center;
            }
            .not-found h1 {
                font-size: 5em;
                margin: 0 0 0.1em;
                color: rgb(var(--gray));
                line-height: 1;
            }
            .not-found p {
                font-size: 1.1em;
                color: rgb(var(--gray));
                margin: 0.5em 0 2em;
            }
        </style>
    </head>
    <body>
        <Header />
        <div class="layout-wrapper">
            <main id="main-content">
                <div class="not-found">
                    <h1>404</h1>
                    <p>ページが見つかりませんでした</p>
                </div>
            </main>
            <Sidebar />
        </div>
        <Footer />
    </body>
</html>
