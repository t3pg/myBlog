---
import { getCollection } from "astro:content";
import PostListLayout from "../../layouts/PostListLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE, POSTS_PER_PAGE } from "../../consts";

const allPosts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const lastPage = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice(0, POSTS_PER_PAGE);

// ページ1は /blog/、ページ2以降は /blog/page/N/
const hrefForPage = (page: number) =>
	page <= 1 ? "/blog/" : `/blog/page/${page}/`;
---

<PostListLayout
	metaTitle={SITE_TITLE}
	metaDescription={SITE_DESCRIPTION}
	heading="All posts"
	totalCount={allPosts.length}
	showTags={true}
	posts={posts}
	currentPage={1}
	lastPage={lastPage}
	hrefForPage={hrefForPage}
/>
