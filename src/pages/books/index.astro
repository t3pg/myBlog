---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Sidebar from "../../components/Sidebar.astro";
import { SITE_TITLE } from "../../consts";
import raw from "./books.csv?raw";

const lines = raw
	.trim()
	.split("\n")
	.filter((line) => line.trim() !== "");
const headers = lines[0].split(",");
const books = lines.slice(1).map((line) => {
	const values = line.split(",");
	return Object.fromEntries(
		headers.map((h, i) => [h.trim(), values[i]?.trim() ?? ""]),
	);
});
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`蔵書一覧 | ${SITE_TITLE}`} description="持ってる本の一覧" />
	</head>
	<body>
		<Header />
		<div class="layout-wrapper">
			<main>
				<header class="pg-intro">
					<h1 class="pg-title">Books</h1>
					<span class="pg-meta">{books.length} books</span>
				</header>
				<p class="pg-desc">僕の持ってる本の一覧。読みたい人がいれば貸します。</p>

				<ul class="book-list">
					{
						books.map((book) => (
							<li class="book-item">
								<img
									class="book-cover"
									src={`https://books.google.com/books/content?vid=ISBN${book.ISBN}&printsec=frontcover&img=1&zoom=1`}
									alt={book.title}
									width="72"
									height="108"
									loading="lazy"
								/>
								<div class="book-body">
									<div class="book-title">{book.title}</div>
									<div class="book-author">{book.author}</div>
									{book.comment && (
										<p class="book-comment">{book.comment}</p>
									)}
								</div>
							</li>
						))
					}
				</ul>

				<p class="pg-note">表紙画像は Google Books から取得しています。</p>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>

<style>
	.pg-intro {
		margin-bottom: 12px;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		border-bottom: 1px solid var(--hairline);
		padding-bottom: 16px;
	}
	.pg-title {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 0.01em;
		margin: 0;
	}
	.pg-meta {
		font-size: 12.5px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.pg-desc {
		font-size: 14px;
		color: var(--muted);
		margin: 12px 0 28px;
		line-height: 1.7;
	}
	.pg-note {
		font-size: 12px;
		color: var(--muted);
		margin-top: 32px;
	}

	.book-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	.book-item {
		display: flex;
		gap: 20px;
		align-items: flex-start;
		padding: 20px 0;
		border-bottom: 1px solid var(--hairline);
	}

	.book-cover {
		width: 72px;
		height: 108px;
		object-fit: cover;
		flex-shrink: 0;
		border-radius: 3px;
		border: 1px solid var(--hairline);
		background: var(--surface);
	}

	.book-body {
		flex: 1;
		min-width: 0;
		padding-top: 4px;
	}

	.book-title {
		font-size: 15px;
		font-weight: 700;
		color: var(--ink);
		line-height: 1.5;
		margin-bottom: 4px;
	}

	.book-author {
		font-size: 12.5px;
		color: var(--muted);
		margin-bottom: 8px;
	}

	.book-comment {
		font-size: 13.5px;
		color: var(--ink-2);
		line-height: 1.7;
		margin: 0;
	}

	@media (max-width: 720px) {
		.pg-title {
			font-size: 19px;
		}
	}
</style>
