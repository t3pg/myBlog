---
import { type CollectionEntry, getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import Sidebar from "../../components/Sidebar.astro";
import { SITE_TITLE } from "../../consts";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	const tagSet = new Set<string>();
	posts.forEach((post) => {
		(post.data.tags ?? []).forEach((tag) => tagSet.add(tag));
	});
	return [...tagSet].map((tag) => ({
		params: { tag },
		props: { tag },
	}));
}

interface Props {
	tag: string;
}

const { tag } = Astro.props;

const allPosts = await getCollection("blog");
const posts = allPosts
	.filter((post) => post.data.tags?.includes(tag))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagEntries = await getCollection("tags");
const tagEntry = tagEntries.find((t) => t.id === tag);
const description = tagEntry?.data.description ?? "";
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title={`${tag} | ${SITE_TITLE}`}
			description={description || `${tag} タグの記事一覧`}
		/>
	</head>
	<body>
		<Header />
		<div class="layout-wrapper">
			<main>
				<header class="pg-intro">
					<h1 class="pg-title">#{tag}</h1>
					<span class="pg-meta">{posts.length} entries</span>
				</header>

				{description && <p class="pg-description">{description}</p>}

				<section class="post-list">
					{
						posts.map((post) => (
							<a
								href={`/blog/${post.id.split("/").pop()}/`}
								class="post-row"
							>
								<div class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<div class="post-main">
									<h2 class="post-title">{post.data.title}</h2>
									{post.data.description && (
										<p class="post-excerpt">
											{post.data.description}
										</p>
									)}
								</div>
							</a>
						))
					}
				</section>

				<a class="back" href="/tags/">← タグ一覧へ</a>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>

<style>
	.pg-intro {
		margin-bottom: 28px;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		border-bottom: 1px solid var(--hairline);
		padding-bottom: 16px;
	}
	.pg-title {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 0.01em;
		margin: 0;
	}
	.pg-meta {
		font-size: 12.5px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.pg-description {
		font-size: 14px;
		color: var(--muted);
		margin: -12px 0 24px;
		line-height: 1.7;
	}

	.post-list {
		display: block;
	}

	.post-row {
		display: grid;
		grid-template-columns: 92px 1fr;
		gap: 24px;
		padding: 22px 0;
		border-bottom: 1px solid var(--hairline);
		align-items: baseline;
		text-decoration: none;
		color: inherit;
	}

	.post-date {
		color: var(--muted);
		font-size: 12.5px;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.02em;
		padding-top: 4px;
	}

	.post-main {
		min-width: 0;
	}

	.post-title {
		font-size: 17px;
		font-weight: 700;
		line-height: 1.5;
		margin: 0 0 6px 0;
		color: var(--accent-text);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: text-decoration-color 0.15s;
	}
	.post-row:hover .post-title {
		text-decoration-color: var(--accent);
	}

	.post-excerpt {
		font-size: 13.5px;
		line-height: 1.7;
		color: var(--muted);
		margin: 6px 0 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.back {
		display: inline-block;
		margin-top: 28px;
		font-size: 13px;
		color: var(--muted);
		text-decoration: none;
		transition: color 0.15s;
	}
	.back:hover {
		color: var(--accent-text);
	}

	@media (max-width: 720px) {
		.pg-title {
			font-size: 19px;
		}
		.post-row {
			grid-template-columns: 1fr;
			gap: 6px;
			padding: 18px 0;
		}
		.post-date {
			padding-top: 0;
		}
		.post-title {
			font-size: 16px;
		}
	}
</style>
